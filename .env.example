# 复制为 .env.local 后填写。.env.local 已被 .gitignore 排除,永远不要提交真实值。
# 所有包与工具只从环境变量 / 运行时输入读取凭据,代码里不写死。

# 目标 ThingsBoard(生产镜像 LXC 111)
TB_BASE=http://192.168.20.61:8080
TB_USER=tenant@thingsboard.org
TB_PASSWORD=<password>

# Customer 视角预览 / 验收用的 CUSTOMER_USER 账号(T0.4 锁定)
TB_CUSTOMER_USER=<customer-user-email>
TB_CUSTOMER_PASSWORD=<password>

# kzserver 扩展服务(仅 ADR-004 选 ext 路线时需要)
KZ_BASE=http://192.168.20.61:8099
