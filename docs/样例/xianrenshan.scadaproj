  "rules": {
    "schema": "tbsite/v2",
    "site": {
      "name": "xianrenshan",
      "label": "仙人山服务区"
    },
    "outputPrefix": "calc_",
    "devices": [
      {
        "name": "SSP1_GP1_IED1",
        "label": "一级开闭所 · 进线 1 测控",
        "type": "IED",
        "profile": "IED",
        "keys": [
          {
            "key": "Uab",
            "label": "线电压 Uab",
            "unit": "V"
          },
          {
            "key": "Ubc",
            "label": "线电压 Ubc",
            "unit": "V"
          },
          {
            "key": "Uca",
            "label": "线电压 Uca",
            "unit": "V"
          },
          {
            "key": "P",
            "label": "有功功率",
            "unit": "kW"
          },
          {
            "key": "Q",
            "label": "无功功率",
            "unit": "kvar"
          },
          {
            "key": "switch_state",
            "label": "开关状态",
            "unit": ""
          },
          {
            "key": "Ia",
            "label": "A 相电流",
            "unit": "A"
          },
