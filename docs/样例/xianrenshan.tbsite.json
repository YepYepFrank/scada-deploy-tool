  "deviceTemplates": [
    {
      "name": "IED 功率监控",
      "selector": {
        "profiles": ["IED"],
        "prefixes": []
      },
      "items": [
        {
          "template": "alarm.threshold",
          "name": "功率越限告警",
          "key": "P",
          "condition": {
            "op": "gt",
            "value": 45
          },
          "severity": "WARNING",
          "trigger": "edge",
          "message": "有功功率越限:{value} kW"
        },
        {
          "template": "expr.add",
          "inputs": {
            "a": {
              "key": "P"
            },
            "b": {
              "key": "Q"
            }
          },
          "output": "pqSum"
        }
      ]
    },
    {
      "name": "配电房进线电压监视",
      "selector": {
        "profiles": ["IED"],
        "prefixes": ["PDR1_LP", "PDR4_LP"]
      },
      "items": [
        {
          "template": "alarm.threshold",
          "name": "400V 电压越下限",
          "key": "Ua",
          "condition": {
            "op": "lt",
            "value": 200
          },
          "severity": "MAJOR",
          "trigger": "level",
          "message": "进线电压偏低:{value} V"
        },
        {
          "template": "alarm.threshold",
          "name": "400V 电压越上限",
          "key": "Ua",
          "condition": {
            "op": "gt",
            "value": 240
          },
          "severity": "MAJOR",
          "trigger": "level",
          "message": "进线电压偏高:{value} V"
        }
      ]
    },
    {
      "name": "IED 多级归档(代表间隔)",
      "selector": {
        "profiles": ["IED"],
        "prefixes": ["SSP1_GP1_", "SSP1_GP8_"]
      },
      "items": [
        {
          "template": "window.cascade",
          "keys": ["P"],
          "aggs": ["avg", "max"]
        }
      ]
    }
  ],
  "computations": [
    {
      "template": "aggregate.crossEntity",
      "name": "全站总有功功率",
      "selector": {
        "profiles": ["IED"],
        "prefixes": []
      },
      "key": "P",
      "agg": "sum",
      "asset": "xianrenshan-agg",
      "output": "totalP"
    },
    {
      "template": "aggregate.crossEntity",
      "name": "配电房进线总有功",
      "selector": {
        "profiles": ["IED"],
        "prefixes": ["PDR1_LP", "PDR4_LP"]
      },
      "key": "P",
      "agg": "sum",
      "asset": "xianrenshan-agg",
      "output": "pdrInP"
    }
  ],
  "rollup": {},
  "alarm": {
    "propagate": true
  }
}
