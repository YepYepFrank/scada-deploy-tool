      "type": "number-card",
      "props": {
        "title": "进线有功",
        "subtitle": "ACTIVE POWER",
        "unit": "kW",
        "decimals": 1,
        "sub": "SSP1_GP1_IED1 · P"
      },
      "bindings": {
        "value": {
          "mode": "ts",
          "entity": { "type": "DEVICE", "id": "bafa3730-528e-11f1-90ba-53cf2ab0fe96", "name": "SSP1_GP1_IED1" },
          "key": "P"
