{
  "name": "scada-deploy-tool",
  "private": true,
  "version": "0.0.1",
  "description": "0 代码部署工具(ThingsBoard SCADA)· v2 架构一期 monorepo",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"@grid/*\" run build",
    "pack:delivery": "node scripts/pack-delivery.mjs",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "gen:schema": "pnpm -F @grid/scada-renderer run gen:schema",
    "tbsite": "pnpm -F @grid/tbsite-compiler run tbsite --",
    "dev": "pnpm -F deploy-tool dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15",
    "prettier": "^3.4.2",
    "tsup": "^8",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
