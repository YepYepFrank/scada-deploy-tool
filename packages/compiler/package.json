{
  "name": "@grid/tbsite-compiler",
  "version": "0.1.0",
  "description": "规则编译核心(tbsite 配置 → 写入计划,纯函数)+ 写入器 + tbsite CLI;tbsite_compile.py 冻结后的唯一编译器",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./build-info.json": "./build-info.json"
  },
  "bin": {
    "tbsite": "./bin/tbsite.mjs"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "build-info.json"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node ../../scripts/build-info.mjs . && tsup",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "tbsite": "node bin/tbsite.mjs",
    "regen:py-plans": "node scripts/regen-python-plans.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./build-info.json": "./build-info.json"
    }
  },
  "sideEffects": false
}
