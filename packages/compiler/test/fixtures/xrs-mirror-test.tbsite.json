  "deviceTemplates": [
    {
      "name": "IED 三相监控",
      "selector": {
        "profiles": ["IED"],
        "prefixes": []
      },
      "items": [
        {
          "template": "alarm.threshold",
          "name": "功率越限告警",
          "key": "P",
          "condition": {
            "op": "gt",
            "value": 500
          },
          "severity": "WARNING",
          "message": "有功功率越限:{value} kW",
          "trigger": "edge"
        },
        {
          "template": "expr.add",
          "inputs": {
            "a": {
              "key": "P"
            },
            "b": {
              "key": "Q"
            }
          },
          "output": "pqSum"
        }
      ]
    }
  ],
  "computations": [
    {
      "template": "aggregate.crossEntity",
      "name": "全站总有功功率",
      "selector": {
        "profiles": ["IED"],
        "prefixes": []
      },
      "key": "P",
      "agg": "sum",
      "asset": "RT_TOTAL_P_TEST",
      "output": "totalP"
    },
    {
      "template": "revenue.periodic",
      "name": "润扬储能收益",
      "charge": {
        "device": "RY_GZ_ESS_PCS",
        "key": "AC_CHG_HIST"
      },
      "discharge": {
        "device": "RY_GZ_ESS_PCS",
        "key": "AC_DISCHG_HIST"
      },
      "priceAsset": "JIZHAN_EELECTRICITY_PRICE_CONFIG",
      "window": "5m",
      "asset": "RT_REVENUE_TEST",
      "output": "revenue5m"
    },
    {
      "template": "window.cascade",
      "device": "PDR1_LP1_IED1",
      "keys": ["P"],
      "aggs": ["avg", "max"]
    },
    {
      "template": "expr.custom",
      "device": "PDR1_LP1_IED1",
      "output": "absQ",
      "terms": [
        {
          "kind": "key",
          "device": "PDR1_LP1_IED1",
          "key": "Q",
          "abs": true
        },
        {
          "kind": "const",
          "value": 0
        }
      ],
      "ops": ["+"]
    },
    {
      "template": "expr.add",
      "device": "PDR1_LP1_IED1",
      "output": "pqState",
      "outputMode": "attr",
      "inputs": {
        "a": {
          "device": "PDR1_LP1_IED1",
          "key": "P"
        },
        "b": {
          "device": "PDR1_LP1_IED1",
          "key": "Q"
        }
      }
    }
  ],
