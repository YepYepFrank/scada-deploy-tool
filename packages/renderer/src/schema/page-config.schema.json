{
  "$id": "https://grid.local/schemas/page-config/v1.json",
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$ref": "#/definitions/PageConfig",
  "definitions": {
    "PageConfig": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "template": {
          "type": "string",
          "description": "页面模板 id,在渲染器模板注册表中查(如 'overview-a' / 'monitor-3col' / 'grid-3x3')。",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "theme": {
          "type": "string",
          "description": "主题名;缺省用渲染器默认主题。"
        },
        "title": {
          "type": "string",
          "description": "页面标题,供宿主 / 独立薄壳在自己的标头 / 页面列表里显示;渲染器本身不画(要画在页面里的是 `header`)。"
        },
        "header": {
          "$ref": "#/definitions/PageHeader",
          "description": "大屏抬头(0.6.0);不填不画。"
        },
        "widgets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WidgetConfig"
          }
        }
      },
      "required": [
        "schemaVersion",
        "template",
        "widgets"
      ],
      "additionalProperties": false,
      "description": "一整页的配置。导航菜单 / 时钟 / 登录身份不在此内,归宿主应用(架构 §6「三条补充约定」)。"
    },
    "PageHeader": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "主标题,如「仙人山服务区智能微电网监控系统」。为空 = 不画抬头。"
        },
        "subtitle": {
          "type": "string",
          "description": "副标题,常放英文名或一句说明。"
        },
        "org": {
          "type": "string",
          "description": "左侧单位 / 项目名。"
        },
        "logo": {
          "type": "string",
          "description": "左侧图标:`http(s)://…` 或 `data:image/…;base64,…`(部署工具选图后转 data URI 存进来,限 200 KB)。",
          "maxLength": 300000
        },
        "align": {
          "type": "string",
          "enum": [
            "center",
            "left"
          ],
          "description": "主标题对齐:居中(缺省)或靠左。"
        },
        "show": {
          "type": "boolean",
          "description": "false = 配置留着但不画(编辑器里的「显示抬头」开关);缺省视为 true。"
        }
      },
      "additionalProperties": false,
      "description": "大屏抬头(0.6.0):页面顶部那条标题带,**属于页面本身**(工程人员在部署工具里填,跟着页面一起发布)。 与架构 §6「页面标头 / 导航菜单 / 时钟归宿主」不冲突:那说的是宿主应用自己的框架——导航、时钟、 登录身份;这里是这张大屏印在最上面的名字,换一张页面就该换一个,只能由配页面的人决定。 不配 `header`(或 `title` 为空)就不画,行为与 0.5.0 一致;宿主想自己画可传 `<ScadaPage :header=\"false\">`。"
    },
    "WidgetConfig": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "页面内唯一、创建后不变:宿主按「页面 id + 组件 id」引用单张卡片(<ScadaWidget> / pickWidget)。 工具在创建组件时生成一次(`w_` + 8 位随机),改属性 / 绑定 / 换模板都不变;换组件类型 = 新组件 = 新 id; 将来若有移动 / 复制:移动只改 slot,复制生成新 id。旧页面的 `w-<slot>` / `<type>-<slot>` 形式继续有效。渲染器只要求唯一。",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "slot": {
          "type": "string",
          "description": "模板槽位名(如 'r1c2' / 'main' / 'side-top'),须存在于所选模板的 slots 中。",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "type": {
          "type": "string",
          "description": "组件类型,在组件注册表中查(如 'number-card' / 'gauge' / 'line' / 'alarm-list')。",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "props": {
          "type": "object",
          "additionalProperties": {},
          "description": "组件自定义属性,形状由该组件的 propsSchema 决定;渲染器按 propsSchema 校验。"
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/definitions/Binding"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/Binding"
                }
              }
            ]
          },
          "description": "绑定:组件「绑定槽位名」→ 数据来源。 声明 `multiple: true` 的绑定槽位(如曲线的 series)**必须**写成数组,一项一序列,单条也写成一项的数组; 非 multiple 槽位必须是单个对象。JSON Schema 无法按槽位区分,由注册表运行时校验强制(T0.1 回填 B2,2026-09-04)。"
        },
        "actions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Action"
          },
          "description": "写操作:契约保留,一期不实现。渲染器一期只做 schema 校验并把对应组件渲染为禁用态(架构 §0 ⑤、§8)。"
        }
      },
      "required": [
        "id",
        "slot",
        "type",
        "bindings"
      ],
      "additionalProperties": false
    },
    "Binding": {
      "anyOf": [
        {
          "$ref": "#/definitions/TsBinding"
        },
        {
          "$ref": "#/definitions/TsHistoryBinding"
        },
        {
          "$ref": "#/definitions/AttrBinding"
        },
        {
          "$ref": "#/definitions/AlarmBinding"
        },
        {
          "$ref": "#/definitions/ConstBinding"
        },
        {
          "$ref": "#/definitions/ExtBinding"
        }
      ]
    },
    "TsBinding": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "ts"
        },
        "entity": {
          "$ref": "#/definitions/EntitySource"
        },
        "key": {
          "$ref": "#/definitions/KeySource",
          "minLength": 1
        }
      },
      "required": [
        "mode",
        "entity",
        "key"
      ],
      "additionalProperties": false,
      "description": "实时遥测:订阅一个 key 的最新值与后续推送。"
    },
    "EntitySource": {
      "anyOf": [
        {
          "$ref": "#/definitions/EntityRef"
        },
        {
          "$ref": "#/definitions/ContextEntityRef"
        }
      ],
      "description": "固定实体,或取自上下文"
    },
    "EntityRef": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "DEVICE",
            "ASSET"
          ]
        },
        "id": {
          "type": "string",
          "description": "ThingsBoard 实体 UUID"
        },
        "name": {
          "type": "string",
          "description": "显示名(设备 name 或 label),由工具发布时按解析结果写入,**仅供组件显示**(标题、图例、表格列), 不作为查找 / 订阅依据——渲染器与数据层仍只按 id 工作。T0.1 回填 A2(庄艳芹)采纳,2026-09-04。"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false,
      "description": "实体引用:渲染器与数据层只认 id(项目文件里按名称存、发布时解析为 id 的规则见 ADR-002)。"
    },
    "ContextEntityRef": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "const": "context"
        },
        "key": {
          "$ref": "#/definitions/ContextKey"
        },
        "type": {
          "type": "string",
          "enum": [
            "DEVICE",
            "ASSET"
          ],
          "description": "期望的实体类型;填了就校验,上下文给的类型不符 → 该卡显示配置错误而不是去订阅"
        },
        "fallback": {
          "$ref": "#/definitions/EntityRef",
          "description": "样例 / 兜底实体:编辑器靠它挑测点、出预览。**运行时只有 whenMissing 为 'fallback' 才用它**—— 样例设备不该悄悄成为生产页面的默认值。"
        },
        "whenMissing": {
          "$ref": "#/definitions/WhenMissing"
        }
      },
      "required": [
        "source",
        "key"
      ],
      "additionalProperties": false,
      "description": "实体取自上下文"
    },
    "ContextKey": {
      "type": "string",
      "description": "上下文键:标准键 `selectedSite` / `selectedDevice` / `selectedMeasurePoint` / `timeRange`, 其余业务键一律放在 `custom` 下(`custom.selectedTu`),避免顶层键名失控。`selectedAlarm` 为预留,一期绑定不可引用。",
      "pattern": "^(selectedSite|selectedDevice|selectedMeasurePoint|timeRange|custom\\.[A-Za-z][A-Za-z0-9_]*)$"
    },
    "WhenMissing": {
      "type": "string",
      "enum": [
        "empty",
        "hide",
        "error",
        "fallback"
      ],
      "description": "上下文里没有这个键(或为 null)时这张卡怎么办:\n- `empty`(缺省):显示中性的「未选择设备」空态,不请求、不订阅、不算报错;\n- `hide`:整张卡不画;\n- `error`:显示错误态并抛 bindError(这一页必须有上下文才有意义时用);\n- `fallback`:用 `fallback` 去订阅(必须同时给 fallback;适合「默认先看 1# PCS」的页面)。"
    },
    "KeySource": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/ContextKeyRef"
        }
      ],
      "description": "固定测点,或取自上下文"
    },
    "ContextKeyRef": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "const": "context"
        },
        "key": {
          "$ref": "#/definitions/ContextKey"
        },
        "fallback": {
          "type": "string",
          "minLength": 1
        },
        "whenMissing": {
          "$ref": "#/definitions/WhenMissing"
        }
      },
      "required": [
        "source",
        "key"
      ],
      "additionalProperties": false,
      "description": "测点(key)取自上下文:历史数据页「选测点」用。上下文里的值是 key 字符串或 `{ key, label?, unit? }`"
    },
    "TsHistoryBinding": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "ts-history"
        },
        "entity": {
          "$ref": "#/definitions/EntitySource"
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/KeySource"
          },
          "minItems": 1
        },
        "window": {
          "$ref": "#/definitions/WindowSource",
          "description": "时间窗口:'15m' / '24h' / '7d',或绝对区间 { from, to },或取自上下文(0.9.0)"
        },
        "agg": {
          "$ref": "#/definitions/Aggregation",
          "description": "缺省由数据层按窗口长度自适应。"
        }
      },
      "required": [
        "mode",
        "entity",
        "keys",
        "window"
      ],
      "additionalProperties": false,
      "description": "历史 + 实时追加:先按窗口拉历史,再订阅同 key 追加。"
    },
    "WindowSource": {
      "anyOf": [
        {
          "$ref": "#/definitions/WindowLiteralString"
        },
        {
          "$ref": "#/definitions/AbsoluteRange"
        },
        {
          "$ref": "#/definitions/ContextWindowRef"
        }
      ],
      "description": "「最近 N」、绝对区间,或取自上下文。绝对区间只拉历史,不追加实时"
    },
    "WindowLiteralString": {
      "type": "string",
      "description": "时间窗口字面量:整数 + 单位(m / h / d),如 '15m' / '24h' / '7d'。",
      "pattern": "^\\d+(m|h|d)$"
    },
    "AbsoluteRange": {
      "type": "object",
      "properties": {
        "from": {
          "type": "number"
        },
        "to": {
          "type": "number"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "description": "绝对时间区间(2026-09-21,历史数据页「选起止日期」用):毫秒时间戳,`from < to`。 与窗口字面量并列——`getHistory` 的第三个参数两种都收,实现内部统一换成 startTs / endTs。"
    },
    "ContextWindowRef": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "const": "context"
        },
        "key": {
          "$ref": "#/definitions/ContextKey"
        },
        "fallback": {
          "anyOf": [
            {
              "$ref": "#/definitions/WindowLiteralString"
            },
            {
              "$ref": "#/definitions/AbsoluteRange"
            }
          ]
        },
        "whenMissing": {
          "$ref": "#/definitions/WhenMissing"
        }
      },
      "required": [
        "source",
        "key"
      ],
      "additionalProperties": false,
      "description": "时间范围取自上下文:上下文里的值是窗口字面量('24h')或绝对区间 `{ from, to }`(毫秒 / ISO 字符串 / Date)"
    },
    "Aggregation": {
      "type": "string",
      "enum": [
        "AVG",
        "MIN",
        "MAX",
        "SUM",
        "COUNT",
        "NONE"
      ],
      "description": "历史聚合方式;`NONE` 为原始点。数据层按窗口长度自适应默认粒度(见 契约-v1.md §4.2)。"
    },
    "AttrBinding": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "attr"
        },
        "entity": {
          "$ref": "#/definitions/EntitySource"
        },
        "scope": {
          "$ref": "#/definitions/AttributeScope"
        },
        "key": {
          "$ref": "#/definitions/KeySource",
          "minLength": 1
        }
      },
      "required": [
        "mode",
        "entity",
        "scope",
        "key"
      ],
      "additionalProperties": false,
      "description": "属性:订阅 server / shared / client scope 的某个属性。"
    },
    "AttributeScope": {
      "type": "string",
      "enum": [
        "SERVER_SCOPE",
        "SHARED_SCOPE",
        "CLIENT_SCOPE"
      ]
    },
    "AlarmBinding": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "alarm"
        },
        "entity": {
          "$ref": "#/definitions/EntitySource"
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "mode",
        "entity"
      ],
      "additionalProperties": false,
      "description": "告警:该实体当前活动告警;`types` 不填为全部,填了只看指定告警类型(状态卡 / 横幅按告警名过滤)。"
    },
    "ConstBinding": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "const"
        },
        "value": {}
      },
      "required": [
        "mode",
        "value"
      ],
      "additionalProperties": false,
      "description": "常量:编辑器缩略图与 /dev 展示页用假数据渲染;也用于 image.src 这类静态值。"
    },
    "ExtBinding": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "ext"
        },
        "source": {
          "type": "string",
          "description": "外部源标识,一期固定 'kz'。",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "window": {
          "$ref": "#/definitions/WindowSource",
          "description": "时间窗口:同 ts-history(0.9.0 起同样可以是绝对区间或取自上下文)。"
        },
        "interval": {
          "$ref": "#/definitions/ExtInterval",
          "description": "聚合粒度,对齐 kz 支持的枚举。"
        },
        "params": {
          "type": "object",
          "additionalProperties": {},
          "description": "源特有参数(站点 / 业务 id、指标名等)。kz 通用历史查询的 `params.entity` 与 `params.keys[i]` 同样可以写成取自上下文的形式(`{ source: 'context', key: … }`),由渲染器在调用 ext() 前解析。"
        }
      },
      "required": [
        "mode",
        "source",
        "params"
      ],
      "additionalProperties": false,
      "description": "外部数据源(kz 归档 / 报表):TB 只保留 3–7 天原始遥测,≥ 3 天窗口或 ≥ 1 天粒度的统计一律从 kz 取 (T0.1 回填 A4,2026-09-04;ADR-004 改为正式路线)。`params` 形状待澄清会拿到 kz 通用查询接口后冻结。"
    },
    "ExtInterval": {
      "type": "string",
      "enum": [
        "1m",
        "5m",
        "1h",
        "1d",
        "1M",
        "1y"
      ],
      "description": "kz 归档粒度枚举(T0.1 回填 B1:仅支持 1 分钟 / 5 分钟 / 1 小时 / 天 / 月 / 年)。"
    },
    "Action": {
      "anyOf": [
        {
          "$ref": "#/definitions/RpcAction"
        },
        {
          "$ref": "#/definitions/AttrWriteAction"
        }
      ]
    },
    "RpcAction": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "rpc"
        },
        "entity": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "DEVICE"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "confirm": {
          "type": "boolean",
          "description": "true 时执行前弹二次确认。"
        }
      },
      "required": [
        "kind",
        "entity",
        "method"
      ],
      "additionalProperties": false,
      "description": "RPC 写操作(二期)。只允许绑 DEVICE,由 JSON Schema 的 entity.type 常量约束。"
    },
    "AttrWriteAction": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "attr"
        },
        "entity": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "DEVICE"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        "scope": {
          "type": "string",
          "enum": [
            "SHARED_SCOPE",
            "SERVER_SCOPE"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "entity",
        "scope",
        "key"
      ],
      "additionalProperties": false,
      "description": "写属性(二期)。只允许绑 DEVICE 的 SHARED_SCOPE / SERVER_SCOPE。"
    }
  },
  "title": "PageConfig v1",
  "description": "0 代码部署工具 · 页面配置契约 v1(由 page-config.ts 生成,请勿手改)"
}
