{
  "schemaVersion": 1,
  "template": "overview-a",
  "title": "仙人山储能站 · 总览",
  "widgets": [
    {
      "id": "w-s1",
      "slot": "s1",
      "type": "number-card",
      "props": { "title": "PCS 有功", "unit": "kW", "decimals": 1 },
      "bindings": {
        "value": {
          "mode": "ts",
          "entity": { "type": "DEVICE", "id": "96424640-7c36-11f1-8007-51b9f7714bbe" },
          "key": "P"
        }
      }
    },
    {
      "id": "w-s2",
      "slot": "s2",
      "type": "gauge",
      "props": { "title": "SOC", "unit": "%", "min": 0, "max": 100 },
      "bindings": {
        "value": {
          "mode": "ts",
          "entity": { "type": "DEVICE", "id": "96424640-7c36-11f1-8007-51b9f7714bbe" },
          "key": "bms_soc"
        }
      }
    },
    {
      "id": "w-s3",
      "slot": "s3",
      "type": "status-light",
      "props": { "title": "通讯", "onValue": 1, "labels": ["中断", "正常"] },
      "bindings": {
        "state": {
          "mode": "attr",
          "entity": { "type": "DEVICE", "id": "96424640-7c36-11f1-8007-51b9f7714bbe" },
          "scope": "SERVER_SCOPE",
          "key": "active"
        }
      }
    },
    {
      "id": "w-g1",
      "slot": "g1",
      "type": "line",
      "props": { "title": "全站功率 24h", "style": "area" },
      "bindings": {
        "series": [
          {
            "mode": "ts-history",
            "entity": { "type": "ASSET", "id": "5ab0e2d0-7c36-11f1-8007-51b9f7714bbe" },
            "keys": ["calc_total_p"],
            "window": "24h",
            "agg": "AVG"
          },
          {
            "mode": "ts-history",
            "entity": { "type": "ASSET", "id": "5ab0e2d0-7c36-11f1-8007-51b9f7714bbe" },
            "keys": ["calc_total_load"],
            "window": "24h"
          }
        ]
      }
    },
    {
      "id": "w-g2",
      "slot": "g2",
      "type": "alarm-list",
      "props": { "maxRows": 20 },
      "bindings": {
        "alarms": {
          "mode": "alarm",
          "entity": { "type": "ASSET", "id": "5ab0e2d0-7c36-11f1-8007-51b9f7714bbe" },
          "types": ["通讯中断", "电压越限"]
        }
      }
    },
    {
      "id": "w-g3",
      "slot": "g3",
      "type": "image",
      "props": { "fit": "contain" },
      "bindings": {
        "src": { "mode": "const", "value": "/assets/site-photo.png" }
      }
    },
    {
      "id": "w-g4",
      "slot": "g4",
      "type": "switch",
      "props": { "label": "PCS 并网" },
      "bindings": {
        "state": {
          "mode": "attr",
          "entity": { "type": "DEVICE", "id": "96424640-7c36-11f1-8007-51b9f7714bbe" },
          "scope": "SHARED_SCOPE",
          "key": "grid_on"
        }
      },
      "actions": {
        "toggle": {
          "kind": "rpc",
          "entity": { "type": "DEVICE", "id": "96424640-7c36-11f1-8007-51b9f7714bbe" },
          "method": "setGridOn",
          "confirm": true
        }
      }
    }
  ]
}
