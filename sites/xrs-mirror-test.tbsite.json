  "deviceTemplates": [
    {
      "name": "IED 功率监控",
      "selector": {
        "profiles": ["IED"],
        "prefixes": []
      },
      "items": [
        {
          "template": "alarm.threshold",
          "name": "功率越限告警",
          "key": "P",
          "condition": {
            "op": "gt",
            "value": 45
          },
          "severity": "WARNING",
          "trigger": "edge",
          "message": "有功功率越限:{value} kW"
        },
        {
          "template": "expr.add",
          "inputs": {
            "a": {
              "key": "P"
            },
            "b": {
              "key": "Q"
            }
          },
          "output": "pqSum"
        }
      ]
    },
    {
      "name": "IED 多级归档(代表间隔)",
      "selector": {
        "profiles": ["IED"],
        "prefixes": ["SSP1_GP1_", "SSP1_GP8_"]
      },
      "items": [
        {
          "template": "window.cascade",
          "keys": ["P"],
          "aggs": ["avg", "max"]
        }
      ]
    }
  ],
  "computations": [
    {
      "template": "aggregate.crossEntity",
      "name": "全站总有功功率",
      "selector": {
        "profiles": ["IED"],
        "prefixes": []
      },
      "key": "P",
      "agg": "sum",
      "asset": "xrs-mirror-test-agg",
      "output": "totalP"
    }
  ],
  "rollup": {},
  "alarm": {
    "propagate": true
  }
